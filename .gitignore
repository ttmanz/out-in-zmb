# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env
.env*.local

# Google Play service account key — never commit this
google-service-account.json

# Firebase Admin SDK key (FCM push credentials) — never commit this
firebase-adminsdk.json

# Firebase client config for Android FCM registration — never commit this
google-services.json

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android

# editor / local tooling
.claude/launch.json

# supabase local temp
supabase/.temp/
.supabase-token
.supabase-new-db-pass.txt
.migration-log.txt
AuthKey_*.p8
